<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PizzaTownDHA</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom Styles -->
    <style>
        body {
            background-color: #f8f6f3;
        }
        /* PIZZA RED NAVBAR */
        .navbar-custom {
            background-color: #b33c2e;
        }

            .navbar-custom .nav-link {
                color: white !important;
            }

                .navbar-custom .nav-link:hover {
                    color: #ffdddd !important;
                }

            .navbar-custom .navbar-brand {
                color: white !important;
            }
    </style>
</head>
<body>

    <!-- ========================================== -->
    <!-- 1. NAVBAR (The Top Menu)                    -->
    <!-- ========================================== -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-custom border-bottom box-shadow mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-pizza me-2"></i> PizzaTownDHA
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Units" asp-action="Index">Units</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ========================================== -->
    <!-- 2. MAIN CONTENT (Where your Views load)    -->
    <!-- ========================================== -->
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ========================================== -->
    <!-- 3. FOOTER (The Bottom of the page)         -->
    <!-- ========================================== -->
    <footer class="border-top footer text-muted mt-5 py-4">
        <div class="container text-center">
            <i class="bi bi-heart-fill text-danger me-2"></i>
            Built with love for a special someone.
            <br />
            <small>&copy; @DateTime.Now.Year - PizzaTownDHA</small>
        </div>
    </footer>

    <!-- ========================================== -->
    <!-- 4. JAVASCRIPT (Vital for Modals to work!)  -->
    <!-- ========================================== -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>