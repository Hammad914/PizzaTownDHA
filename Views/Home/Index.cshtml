@{
    ViewData["Title"] = "Home";
}

<style>
    body {
        background-color: #f8f6f3;
        color: #222;
    }

    .hero-section {
        background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
        color: #f8f6f3;
        padding: 60px 0;
        margin-bottom: 40px;
        border-radius: 0 0 20px 20px;
    }

        .hero-section h1 {
            font-size: 3rem;
            font-weight: 700;
            color: #fff;
        }

        .hero-section .highlight {
            color: #b33c2e;
        }

    .feature-card {
        border: 1px solid #e5ddd4;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        transition: transform 0.2s ease, border-color 0.2s ease;
        text-decoration: none;
        color: #222;
        min-height: 180px;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            border-color: #b33c2e;
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
            color: #b33c2e;
        }

        .feature-card .icon-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 15px;
            background-color: #f8f6f3;
            color: #b33c2e;
        }

        .feature-card h5 {
            font-weight: 700;
            color: #1a1a1a;
        }

        .feature-card p {
            color: #777;
        }
</style>

<div class="hero-section text-center">
    <div class="container">
        <h1><i class="bi bi-pizza-fill me-3"></i>PizzaTownDHA</h1>
        <p class="mx-auto" style="max-width: 600px;">
            <span class="highlight">Professional Restaurant Inventory & Stock Management.</span>
            <br />
            Track units, ingredients, recipes, and stock effortlessly.
        </p>
        <a href="/StockReconciliation" class="btn btn-danger btn-lg rounded-pill mt-3 px-4 fw-bold">
            <i class="bi bi-clipboard-check me-2"></i>Start Today's Stock Count
        </a>
    </div>
</div>

<div class="container pb-5">
    <h2 class="text-center mb-4 fw-bold" style="color: #1a1a1a;">Quick Access</h2>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <a href="/StockReconciliation" class="card feature-card h-100 p-4 text-center">
                <div class="icon-circle mx-auto"><i class="bi bi-clipboard-check"></i></div>
                <h5>Stock Count</h5>
                <p>End-of-day stock count with discrepancy tracking.</p>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="/StockIns/Create" class="card feature-card h-100 p-4 text-center">
                <div class="icon-circle mx-auto"><i class="bi bi-truck"></i></div>
                <h5>Add Stock In</h5>
                <p>Record deliveries and raw material receipts.</p>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="/Units" class="card feature-card h-100 p-4 text-center">
                <div class="icon-circle mx-auto"><i class="bi bi-boxes"></i></div>
                <h5>Units</h5>
                <p>Manage measurement units like kg, g, L, and pcs.</p>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="/Ingredients" class="card feature-card h-100 p-4 text-center">
                <div class="icon-circle mx-auto"><i class="bi bi-basket"></i></div>
                <h5>Ingredients</h5>
                <p>Track raw materials, stock levels, and tolerance.</p>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="/Products" class="card feature-card h-100 p-4 text-center">
                <div class="icon-circle mx-auto"><i class="bi bi-egg-fried"></i></div>
                <h5>Products</h5>
                <p>Create recipes with ingredients and quantities.</p>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="/KitchenLogs" class="card feature-card h-100 p-4 text-center">
                <div class="icon-circle mx-auto"><i class="bi bi-clock-history"></i></div>
                <h5>Kitchen Logs</h5>
                <p>Log production and track what you serve daily.</p>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="/StockReconciliation/History" class="card feature-card h-100 p-4 text-center">
                <div class="icon-circle mx-auto"><i class="bi bi-clock-history"></i></div>
                <h5>Stock History</h5>
                <p>Review past stock counts and daily trends.</p>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="/StockIns" class="card feature-card h-100 p-4 text-center">
                <div class="icon-circle mx-auto"><i class="bi bi-truck"></i></div>
                <h5>Stock In History</h5>
                <p>View all deliveries and receipts.</p>
            </a>
        </div>
    </div>
</div>