@model PizzaTownDHA.Models.Entities.StockIn
@{
    ViewData["Title"] = "Edit Stock In";
    var ingredients = ViewData["IngredientList"] as List<PizzaTownDHA.Models.Entities.Ingredient>;
    var units = ViewData["UnitList"] as List<PizzaTownDHA.Models.Entities.Unit>;
    var currentUnitId = ViewData["CurrentUnitId"] as Guid?;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background-color: #f8f6f3;
    }

    .page-wrapper {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .card {
        overflow: visible !important;
        z-index: 1;
    }
</style>

<div class="container-fluid py-5">
    <div class="page-wrapper">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-warning text-dark border-0 py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Edit Stock In</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    <!-- Preserve the ID using asp-for -->
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <!-- Ingredient Dropdown with DATA ATTRIBUTES for Category and Base Symbol -->
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Ingredient</label>
                            <select name="IngredientId" id="ingredientSelect" class="form-control" required>
                                @if (ingredients != null)
                                {
                                    @foreach (var ing in ingredients)
                                    {
                                        var isSelected = ing.Id == Model.IngredientId ? "selected" : "";
                                        <option value="@ing.Id"
                                                data-category="@(ing.Unit?.Category ?? "")"
                                                data-base-symbol="@(ing.Unit?.UnitSymbol ?? "")"
                                            @isSelected>
                                            @ing.Name (@ing.Unit?.UnitSymbol)
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Quantity Input -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Quantity Received</label>
                            <input type="number" step="any" name="QuantityReceived" id="quantityInput"
                                   class="form-control" value="@Model.QuantityReceived" required />
                        </div>

                        <!-- Dynamic Unit Dropdown -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Select Unit</label>
                            <select name="selectedUnitId" id="unitSelect" class="form-control" required>
                                <!-- Populated by JS -->
                            </select>
                        </div>

                        <!-- Received Date -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Received Date</label>
                            <input type="date" name="ReceivedDate" class="form-control"
                                   value="@Model.ReceivedDate.ToString("yyyy-MM-dd")" required />
                        </div>

                        <!-- Live Preview (User knows what will be saved) -->
                        <div class="col-md-12 mt-2">
                            <div class="alert alert-info py-2 mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                <strong>Converted to Base Unit:</strong>
                                <span id="preview">@Model.QuantityReceived</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-warning rounded-pill px-4 text-dark">Update Stock In</button>
                        <a href="/StockIns" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="tempDataSuccess" value="@TempData["Success"]" />
<input type="hidden" id="tempDataError" value="@TempData["Error"]" />

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Pass all units from server to JavaScript
    const allUnits = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(units));

    // Pass the current selected unit ID so it pre-fills
    const currentUnitId = '@currentUnitId';

    const ingredientSelect = document.getElementById('ingredientSelect');
    const unitSelect = document.getElementById('unitSelect');
    const quantityInput = document.getElementById('quantityInput');
    const preview = document.getElementById('preview');

    // Function to populate unit dropdown based on category
    function populateUnits(category, baseSymbol, selectedUnitId) {
    unitSelect.innerHTML = '<option value="">Select Unit</option>';

    // Filter units by category (Weight, Volume, etc.)
    let filteredUnits = allUnits.filter(u => (u.category || u.Category) === category && !(u.isDeleted || u.IsDeleted));

    filteredUnits.forEach(unit => {
    let option = document.createElement('option');
    option.value = unit.id || unit.Id;
    option.text = unit.unitSymbol || unit.UnitSymbol;
    option.dataset.factor = unit.conversionFactor || unit.ConversionFactor;
    unitSelect.appendChild(option);
    });

    // Pre-select the current unit if provided, otherwise base unit
    if (selectedUnitId && selectedUnitId !== '') {
    unitSelect.value = selectedUnitId;
    } else {
    // Find base unit in list and select it
    let baseOption = Array.from(unitSelect.options).find(o => o.text === baseSymbol);
    if (baseOption) {
    unitSelect.value = baseOption.value;
    }
    }

    updatePreview();
    }

    // Function to update live preview
    function updatePreview() {
    let qty = parseFloat(quantityInput.value) || 0;
    let factor = parseFloat(unitSelect.options[unitSelect.selectedIndex]?.dataset.factor) || 1;
    let baseSymbol = ingredientSelect.options[ingredientSelect.selectedIndex]?.dataset.baseSymbol || '';

    // The Math: 50g * 0.001 = 0.050 kg
    let baseValue = qty * factor;

    preview.innerText = `${baseValue.toFixed(4)} ${baseSymbol}`;
    }

    // Initialize dropdowns on page load
    document.addEventListener('DOMContentLoaded', function() {
    // Get current selected ingredient details
    let category = ingredientSelect.options[ingredientSelect.selectedIndex]?.dataset.category;
    let baseSymbol = ingredientSelect.options[ingredientSelect.selectedIndex]?.dataset.baseSymbol;

    populateUnits(category, baseSymbol, currentUnitId);
    });

    // Handle ingredient change
    ingredientSelect.addEventListener('change', function() {
    let category = this.options[this.selectedIndex].dataset.category;
    let baseSymbol = this.options[this.selectedIndex].dataset.baseSymbol;

    populateUnits(category, baseSymbol, null);
    });

    // Update preview when inputs change
    quantityInput.addEventListener('input', updatePreview);
    unitSelect.addEventListener('change', updatePreview);
</script>