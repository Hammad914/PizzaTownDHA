@model List<PizzaTownDHA.Models.Entities.Ingredient>
@{
    ViewData["Title"] = "Ingredients Management";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background-color: #f8f6f3;
        color: #222222;
    }

    .page-wrapper {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 40px;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.2rem;
        margin-bottom: 2.5rem;
    }

    .info-card {
        flex: 0 0 220px;
        max-width: 220px;
        border: 1px solid #e5ddd4;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 3px 6px rgba(0,0,0,0.04);
        transition: transform 0.2s ease;
        padding: 1rem 0.5rem;
        text-align: center;
    }

        .info-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.06);
        }

        .info-card .bi {
            font-size: 1.6rem;
            color: #777;
        }

        .info-card .bi-database {
            color: #b33c2e;
        }

        .info-card .bi-basket {
            color: #b33c2e;
        }

        .info-card h5 {
            font-size: 0.8rem;
            margin-top: 0.5rem;
            color: #777;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .info-card h2 {
            font-size: 1.4rem;
            margin: 0;
            color: #1a1a1a;
            font-weight: 700;
        }

    .search-box {
        border-radius: 10px 0 0 10px;
        border-right: none;
        background: #ffffff;
        border: 1px solid #ddd6ce;
        padding: 0.6rem 1rem;
    }

    .search-btn {
        border-radius: 0 10px 10px 0;
        background-color: #b33c2e;
        color: white;
        border: 1px solid #b33c2e;
        padding: 0 1.5rem;
    }

    .table-custom {
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0,0,0,0.04);
    }

        .table-custom thead {
            background-color: #1a1a1a;
            color: #ffffff;
        }

            .table-custom thead th {
                font-size: 0.85rem;
                padding: 1rem 1rem;
                font-weight: 600;
                text-transform: uppercase;
            }

        .table-custom tbody td {
            font-size: 1rem;
            padding: 1rem 1rem;
            vertical-align: middle;
            color: #222;
        }

        .table-custom tbody tr:hover {
            background-color: #f9f6f2;
        }

    .action-btn {
        background: transparent;
        border: none;
        font-size: 1.3rem;
        transition: transform 0.2s ease;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 3px;
    }

        .action-btn:hover {
            transform: scale(1.05);
        }

    .btn-icon-view {
        background-color: #f0efed;
        color: #444;
    }

        .btn-icon-view:hover {
            background-color: #dcdcdc;
        }

    .btn-icon-edit {
        background-color: transparent;
        color: #b45f06;
        border: 1px solid #b45f06;
    }

        .btn-icon-edit:hover {
            background-color: #b45f06;
            color: #fff;
        }

    .btn-icon-delete {
        background-color: transparent;
        color: #ba2d0b;
        border: 1px solid #ba2d0b;
    }

        .btn-icon-delete:hover {
            background-color: #ba2d0b;
            color: #fff;
        }

    .modal-detail-row {
        border-bottom: 1px solid #f0eeea;
        padding: 10px 0;
    }

        .modal-detail-row span:first-child {
            color: #777;
            font-weight: 600;
        }

        .modal-detail-row span:last-child {
            font-weight: 500;
        }

    .pagination-btn {
        border: 1px solid #ddd6ce;
        background: #fff;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
    }

        .pagination-btn.active {
            background-color: #1a1a1a;
            color: white;
            border-color: #1a1a1a;
        }
</style>

<div class="container-fluid py-5">
    <div class="page-wrapper">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: #1a1a1a;">
                <i class="bi bi-basket" style="color: #b33c2e; margin-right: 0.5rem;"></i> Ingredients Management
            </h2>
            <p class="text-muted">Manage all your kitchen ingredients and stock levels.</p>
        </div>

        @* <div class="card-container">
            <div class="info-card">
                <i class="bi bi-database"></i>
                <h5>Total</h5>
                <h2 id="totalCountDisplay">@Model.Count</h2>
            </div>


        </div> *@

        <div class="row align-items-center mb-4">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border: 1px solid #ddd6ce; border-right: none; border-radius: 10px 0 0 10px;">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control search-box" placeholder="Type to search by Name, Unit, Stock...">
                    <button class="btn search-btn" onclick="filterTable()">Search</button>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a href="/Ingredients/Create" class="btn btn-dark rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i> Add Ingredient
                </a>
            </div>
        </div>

        <div class="table-responsive table-custom">
            <table class="table table-hover mb-0" id="unitTable">
                <thead>
                    <tr>
                        <th class="ps-4 text-center" style="width: 5%;">#</th>
                        <th class="ps-2">Name</th>
                        <th>Unit</th>
                        <th class="text-center">Minimum Stock</th>
                        <th class="text-center">Tolerance (%)</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @if (Model != null && Model.Count > 0)
                    {
                        int counter = 1;
                        @foreach (var item in Model)
                        {
                            var safeModalId = $"ingredientModal_{item.Name.Replace(" ", "_").Replace(".", "-")}";
                            var deleteModalId = $"deleteModal_{item.Name.Replace(" ", "_").Replace(".", "-")}";

                            <tr class="data-row">
                                <td class="ps-4 text-center fw-bold">@counter</td>
                                <td class="ps-2 fw-normal">@Html.DisplayFor(modelItem => item.Name)</td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2" style="border-color: #ddd6ce !important;">
                                        @item.Unit?.UnitSymbol
                                    </span>
                                </td>
                                <td class="text-center">@item.MinimumStock.ToString("0.##")</td>
                                <td class="text-center fw-bold">@item.Tolerance.ToString("0.##")%</td>
                                <td class="text-center pe-4">
                                    <button type="button" class="action-btn btn-icon-view"
                                            data-bs-toggle="modal"
                                            data-bs-target="#@safeModalId" title="View Details">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                    <a href="/Ingredients/Edit/@item.Id" class="action-btn btn-icon-edit" title="Edit Ingredient">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="action-btn btn-icon-delete"
                                            data-bs-toggle="modal"
                                            data-bs-target="#@deleteModalId" title="Delete Ingredient">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                            </tr>

                            <!-- Details Modal -->
                            <div class="modal fade" id="@safeModalId" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content shadow-lg border-0 rounded-4">
                                        <div class="modal-header border-0 pb-0 pt-4 px-4">
                                            <h5 class="modal-title fw-bold">
                                                <i class="bi bi-info-circle me-2" style="color: #b33c2e;"></i> @item.Name
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body px-4 pb-4 pt-2">
                                            <div class="modal-detail-row d-flex justify-content-between"><span>Name</span><span>@item.Name</span></div>
                                            <div class="modal-detail-row d-flex justify-content-between"><span>Unit</span><span>@item.Unit?.UnitSymbol</span></div>
                                            <div class="modal-detail-row d-flex justify-content-between"><span>Minimum Stock</span><span>@item.MinimumStock</span></div>
                                            <div class="modal-detail-row d-flex justify-content-between"><span>Tolerance</span><span>@item.Tolerance%</span></div>
                                        </div>
                                        <div class="modal-footer border-0 px-4 pb-4">
                                            <button type="button" class="btn btn-dark rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Delete Modal -->
                            <div class="modal fade" id="@deleteModalId" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content shadow-lg border-0 rounded-4">
                                        <div class="modal-header bg-danger text-white border-0 rounded-top-4">
                                            <h5 class="modal-title fw-bold">
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body p-4 text-center">
                                            <p class="fs-5">Are you sure you want to delete <strong>@item.Name</strong>?</p>
                                            <p class="text-muted small">This action cannot be undone.</p>
                                        </div>
                                        <div class="modal-footer border-0 justify-content-center pb-4">
                                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                            <form id="deleteForm_@item.Id" action="/Ingredients/Delete/@item.Id" method="post" style="display:inline;">
                                                <button type="button" class="btn btn-danger rounded-pill px-4" onclick="submitDelete('@item.Id')">
                                                    Yes, Delete
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-basket d-block mb-2" style="font-size: 3rem; color: #ddd6ce;"></i>
                                No ingredients found. Click "Add Ingredient" to get started.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="pagination-container" style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem;" id="paginationControls"></div>
    </div>
</div>

<input type="hidden" id="tempDataSuccess" value="@TempData["Success"]" />
<input type="hidden" id="tempDataError" value="@TempData["Error"]" />

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    let rowsPerPage = 10;
    let currentPage = 1;
    let allRows = [];

    document.addEventListener('DOMContentLoaded', function() {
        allRows = Array.from(document.querySelectorAll('#tableBody .data-row'));
        updateTable();
    });

    document.getElementById('searchInput').addEventListener('keyup', function() {
        let searchValue = this.value.toLowerCase();
        let filteredRows = allRows.filter(row => {
            let text = row.innerText.toLowerCase();
            return text.includes(searchValue);
        });
        currentPage = 1;
        renderPage(filteredRows);
    });

    function filterTable() {
        document.getElementById('searchInput').dispatchEvent(new Event('keyup'));
    }

    function updateTable() {
        renderPage(allRows);
    }

    function renderPage(rows) {
        const tableBody = document.getElementById('tableBody');
        const paginationContainer = document.getElementById('paginationControls');

        tableBody.innerHTML = '';

        let start = (currentPage - 1) * rowsPerPage;
        let end = start + rowsPerPage;
        let paginatedRows = rows.slice(start, end);

        paginatedRows.forEach(row => {
            tableBody.appendChild(row);
        });

        document.getElementById('totalCountDisplay').innerText = rows.length;

        let totalPages = Math.ceil(rows.length / rowsPerPage);
        paginationContainer.innerHTML = '';

        if (totalPages <= 1) return;

        let prevBtn = document.createElement('button');
        prevBtn.className = 'pagination-btn';
        prevBtn.innerText = '‹';
        prevBtn.onclick = function() {
            if (currentPage > 1) { currentPage--; renderPage(rows); }
        };
        paginationContainer.appendChild(prevBtn);

        for (let i = 1; i <= totalPages; i++) {
            let btn = document.createElement('button');
            btn.className = `pagination-btn ${i === currentPage ? 'active' : ''}`;
            btn.innerText = i;
            btn.onclick = function() {
                currentPage = i;
                renderPage(rows);
            };
            paginationContainer.appendChild(btn);
        }

        let nextBtn = document.createElement('button');
        nextBtn.className = 'pagination-btn';
        nextBtn.innerText = '›';
        nextBtn.onclick = function() {
            if (currentPage < totalPages) { currentPage++; renderPage(rows); }
        };
        paginationContainer.appendChild(nextBtn);
    }

    function submitDelete(id) {
        var form = document.getElementById('deleteForm_' + id);
        if (form) {
            form.submit();
        }
    }
</script>