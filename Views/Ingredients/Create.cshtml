@model PizzaTownDHA.Models.Entities.Ingredient
@{
    ViewData["Title"] = "Create Ingredient";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background-color: #f8f6f3;
    }

    .page-wrapper {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .card {
        overflow: visible !important;
        z-index: 1;
    }

    .card-body {
        overflow: visible !important;
    }

    .form-control, select {
        position: relative;
        z-index: 2;
    }
</style>

<div class="container-fluid py-5">
    <div class="page-wrapper">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white border-0 py-3">
                <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i> Create Ingredient</h4>
            </div>
            <div class="card-body p-4">
                <form id="createIngredientForm" asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-bold">Name</label>
                            <input id="Name" name="Name" asp-for="Name" class="form-control" placeholder="e.g. Flour" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UnitId" class="form-label fw-bold">Unit</label>
                            <select id="UnitId" name="UnitId" class="form-control" asp-for="UnitId">
                                <option value="">-- Select Unit --</option>
                                @if (ViewData["UnitSelectList"] != null)
                                {
                                    foreach (var item in (SelectList)ViewData["UnitSelectList"])
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MinimumStock" class="form-label fw-bold">Minimum Stock</label>
                            <input id="MinimumStock" name="MinimumStock" asp-for="MinimumStock" class="form-control" type="number" step="any" placeholder="e.g. 5.0" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Tolerance" class="form-label fw-bold">Tolerance (%)</label>
                            <input id="Tolerance" name="Tolerance" asp-for="Tolerance" class="form-control" type="number" step="0.01" max="75" placeholder="e.g. 10" />
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="button" id="submitBtn" class="btn btn-danger rounded-pill px-4">Create Ingredient</button>
                        <a href="/Ingredients" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="tempDataSuccess" value="@TempData["Success"]" />
<input type="hidden" id="tempDataError" value="@TempData["Error"]" />

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.getElementById('submitBtn').addEventListener('click', function(e) {
        e.preventDefault();

        let name = document.getElementById('Name').value;
        let unitId = document.getElementById('UnitId').value;
        let minStock = document.getElementById('MinimumStock').value;
        let tolerance = document.getElementById('Tolerance').value;

        // Validate
        if (name === "" || unitId === "") {
            alert("Please fill in Name and Unit.");
            return;
        }

        // Build the FormData manually
        let formData = new FormData();
        formData.append('Name', name);
        formData.append('UnitId', unitId);
        formData.append('MinimumStock', minStock);
        formData.append('Tolerance', tolerance);

        // Send it!
        fetch('/Ingredients/Create', {
            method: 'POST',
            body: formData
        })
        .then(response => {
            if (response.redirected) {
                window.location.href = response.url;
            } else {
                window.location.reload();
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
    });
</script>