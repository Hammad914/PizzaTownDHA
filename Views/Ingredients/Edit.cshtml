@model PizzaTownDHA.Models.Entities.Ingredient
@{
    ViewData["Title"] = "Edit Ingredient";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background-color: #f8f6f3;
    }

    .page-wrapper {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .card {
        overflow: visible !important;
        z-index: 1;
    }

    .card-body {
        overflow: visible !important;
    }
</style>

<div class="container-fluid py-5">
    <div class="page-wrapper">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-warning text-dark border-0 py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Edit Ingredient</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">

                    <input type="hidden" name="Id" value="@Model.Id.ToString().Replace("{", "").Replace("}", "")" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-bold">Name</label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UnitId" class="form-label fw-bold">Unit</label>
                            @Html.DropDownListFor(m => m.UnitId,
                            ViewData["UnitSelectList"] as SelectList,
                                                                "-- Select Unit --",
                                                        new { @class = "form-control" })
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MinimumStock" class="form-label fw-bold">Minimum Stock</label>
                            @Html.TextBoxFor(m => m.MinimumStock, new { @class = "form-control", @type = "number", @step = "any" })
                            <span asp-validation-for="MinimumStock" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Tolerance" class="form-label fw-bold">Tolerance (%)</label>
                            @Html.TextBoxFor(m => m.Tolerance, new { @class = "form-control", @type = "number", @step = "0.01", @max = "75" })
                            <span asp-validation-for="Tolerance" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-warning rounded-pill px-4 text-dark">Save Changes</button>
                        <a href="/Ingredients" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="tempDataSuccess" value="@TempData["Success"]" />
<input type="hidden" id="tempDataError" value="@TempData["Error"]" />