@model PizzaTownDHA.Models.Entities.Unit
@{
    ViewData["Title"] = "Edit Unit";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background-color: #f8f6f3;
    }

    .page-wrapper {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 20px;
    }
</style>

<div class="container-fluid py-5">
    <div class="page-wrapper">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-warning text-dark border-0 py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Edit Unit</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">

                    <!-- ID SENT TO CONTROLLER -->
                    <input type="hidden" name="Id" value="@Model.Id.ToString().Replace("{", "").Replace("}", "")" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <!-- Unit Name -->
                        <div class="col-md-6">
                            <label asp-for="UnitName" class="form-label fw-bold">Unit Name</label>
                            <!-- USING TextBoxFor (Bulletproof) -->
                            @Html.TextBoxFor(m => m.UnitName, new { @class = "form-control" })
                            <span asp-validation-for="UnitName" class="text-danger small"></span>
                        </div>

                        <!-- Unit Symbol -->
                        <div class="col-md-6">
                            <label asp-for="UnitSymbol" class="form-label fw-bold">Symbol</label>
                            @Html.TextBoxFor(m => m.UnitSymbol, new { @class = "form-control" })
                            <span asp-validation-for="UnitSymbol" class="text-danger small"></span>
                        </div>

                        <!-- Category -->
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-bold">Category</label>
                            @Html.TextBoxFor(m => m.Category, new { @class = "form-control" })
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <!-- Conversion Factor -->
                        <div class="col-md-6">
                            <label asp-for="ConversionFactor" class="form-label fw-bold">Conversion Factor</label>
                            @Html.TextBoxFor(m => m.ConversionFactor, new { @class = "form-control", @type = "number", @step = "any" })
                            <span asp-validation-for="ConversionFactor" class="text-danger small"></span>
                        </div>

                        <!-- Display Order -->
                        <div class="col-md-6">
                            <label asp-for="DisplayOrder" class="form-label fw-bold">Display Order</label>
                            @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", @type = "number" })
                        </div>

                        <!-- Is Base Unit Checkbox -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Is Base Unit?</label>
                            <div class="form-check form-switch mt-2">
                                @Html.CheckBoxFor(m => m.IsBaseUnit, new { @class = "form-check-input", @id = "isBaseUnit" })
                                <label class="form-check-label" for="isBaseUnit">Yes</label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-warning rounded-pill px-4 text-dark">Save Changes</button>
                        <a href="/Units" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>